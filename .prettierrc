{
   "tabWidth": 3,
   "semi": false,
   "printWidth": 120,
   "trailingComma": "none",
   "bracketSpacing": true,
   "bracketSameLine": true,
   "singleAttributePerLine": true,
   "endOfLine": "auto",
   "singleQuote": true,
   "plugins": ["prettier-plugin-tailwindcss", "prettier-plugin-organize-imports"]
}
